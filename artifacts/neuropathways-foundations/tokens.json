{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "NeuroPathways Phase 1 foundations (DTCG). SINGLE SOURCE OF TRUTH -- edit here, run `pnpm tokens`; never hand-edit src/index.css or src/generated/tokens.tsx. Palette provenance: artifacts/neuropath/src/index.css (:root/.dark HSL roles, converted to hex) and artifacts/neuropath/src/components/navigation/legacy-skin.css (.np-legacy brand blue #496fa4 = HSL 216 38% 47%). See docs/phase-1-foundations.md.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f9f8", "$description": "index.css --background 165 25% 97%" },
      "foreground": { "$value": "#1c313f", "$description": "index.css --foreground 204 38% 18%" },
      "border": { "$value": "#d5e1de", "$description": "index.css --border 165 17% 86%" },
      "card": { "$value": "#ffffff", "$description": "index.css --card" },
      "cardForeground": { "$value": "#1c313f" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#1c313f" },
      "primary": { "$value": "#496fa4", "$description": "Brand blue, .np-legacy --primary 216 38% 47% / #496fa4. Primary actions." },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e7ecef", "$description": "index.css --secondary 199 20% 92%" },
      "secondaryForeground": { "$value": "#233c4d", "$description": "index.css --secondary-foreground 204 38% 22%" },
      "muted": { "$value": "#eaf0ef", "$description": "index.css --muted 165 18% 93%" },
      "mutedForeground": { "$value": "#546773", "$description": "index.css --muted-foreground 204 16% 39%" },
      "accent": { "$value": "#d6ebe5", "$description": "Sea-glass, index.css --accent 164 35% 88%" },
      "accentForeground": { "$value": "#233c4d", "$description": "index.css --accent-foreground 204 38% 22%" },
      "destructive": { "$value": "#d12929", "$description": "Urgent red, index.css --destructive 0 67% 49%" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d5e1de" },
      "ring": { "$value": "#496fa4", "$description": ".np-legacy --ring" },
      "chart1": { "$value": "#496fa4", "$description": "Brand blue" },
      "chart2": { "$value": "#397471", "$description": "Teal, index.css light --primary 177 34% 34%" },
      "chart3": { "$value": "#255653", "$description": "Deep teal text, .np-care-badge 177 40% 24%" },
      "chart4": { "$value": "#546773", "$description": "Muted foreground" },
      "chart5": { "$value": "#d12929", "$description": "Urgent red" },
      "sidebar": { "$value": "#f4f5f7", "$description": ".np-legacy --np-nav-bg" },
      "sidebarForeground": { "$value": "#1c313f" },
      "sidebarBorder": { "$value": "#e3e5e9", "$description": ".np-legacy --np-nav-line" },
      "sidebarPrimary": { "$value": "#496fa4" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#d6ebe5" },
      "sidebarAccentForeground": { "$value": "#233c4d" },
      "sidebarRing": { "$value": "#496fa4" }
    },
    "dark": {
      "background": { "$value": "#121b21", "$description": "index.css .dark --background 204 31% 10%" },
      "foreground": { "$value": "#eaf1ef", "$description": ".dark --foreground 165 20% 93%" },
      "border": { "$value": "#36454e", "$description": ".dark --border 204 18% 26%" },
      "card": { "$value": "#1a262d", "$description": ".dark --card 204 27% 14%" },
      "cardForeground": { "$value": "#eaf1ef" },
      "popover": { "$value": "#1a262d" },
      "popoverForeground": { "$value": "#eaf1ef" },
      "primary": { "$value": "#496fa4", "$description": "Brand blue kept as a FILL only (white text 5.0:1). Not used as text on dark surfaces (3.4:1)." },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#2b3840", "$description": ".dark --secondary 204 20% 21%" },
      "secondaryForeground": { "$value": "#eaf1ef" },
      "muted": { "$value": "#26323b", "$description": ".dark --muted 204 21% 19%" },
      "mutedForeground": { "$value": "#a1b5b0", "$description": ".dark --muted-foreground 165 12% 67%" },
      "accent": { "$value": "#2e4d48", "$description": ".dark --accent 171 25% 24%" },
      "accentForeground": { "$value": "#eaf1ef" },
      "destructive": { "$value": "#d33636", "$description": ".dark --destructive 0 64% 52%" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#36454e" },
      "ring": { "$value": "#66b7ab", "$description": "PREVIEW-ONLY dark adaptation: existing .dark --ring/--primary teal 171 36% 56%, used for visible focus on dark surfaces." },
      "chart1": { "$value": "#496fa4" },
      "chart2": { "$value": "#66b7ab", "$description": "Teal, .dark --primary 171 36% 56%" },
      "chart3": { "$value": "#a1b5b0" },
      "chart4": { "$value": "#36454e" },
      "chart5": { "$value": "#d33636" },
      "sidebar": { "$value": "#1a262d" },
      "sidebarForeground": { "$value": "#eaf1ef" },
      "sidebarBorder": { "$value": "#36454e" },
      "sidebarPrimary": { "$value": "#496fa4" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#2e4d48" },
      "sidebarAccentForeground": { "$value": "#eaf1ef" },
      "sidebarRing": { "$value": "#66b7ab" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["DM Sans", "Inter", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Body/UI (index.css --font-sans). Inter is the legacy .np-legacy fallback." },
      "display": { "$value": ["Manrope", "DM Sans", "sans-serif"], "$description": "Headings (index.css --font-display)." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    },
    "fontSize": {
      "$description": "Phase 1 brief hierarchy. Emitted as Tailwind text-<name> utilities.",
      "page-title": { "$value": "1.625rem", "lineHeight": "1.25", "$description": "26px page title" },
      "section-title": { "$value": "1.25rem", "lineHeight": "1.3", "$description": "20px section title" },
      "card-title": { "$value": "1.0625rem", "lineHeight": "1.35", "$description": "17px card title" },
      "body": { "$value": "1rem", "lineHeight": "1.55", "$description": "16px body" },
      "body-sm": { "$value": "0.9375rem", "lineHeight": "1.55", "$description": "15px body" },
      "support": { "$value": "0.875rem", "lineHeight": "1.45", "$description": "14px supporting" },
      "support-sm": { "$value": "0.8125rem", "lineHeight": "1.45", "$description": "13px supporting / badges" }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.75rem", "$description": "Base corner radius (12px, matches .np-legacy nav items); sm/md/lg/xl derive from it." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Base spacing step components multiply." },
    "semantic": {
      "$description": "Phase 1 rhythm. Emitted as Tailwind spacing names (p-gutter, gap-section, min-h-control...).",
      "gutter": { "$value": "1.25rem", "$description": "20px mobile horizontal margin" },
      "section": { "$value": "2rem", "$description": "32px section spacing (28-36px range)" },
      "related": { "$value": "0.75rem", "$description": "12px related spacing" },
      "related-lg": { "$value": "1rem", "$description": "16px related spacing" },
      "card": { "$value": "1rem", "$description": "16px card padding (mobile)" },
      "card-lg": { "$value": "1.25rem", "$description": "20px card padding (wider)" },
      "list": { "$value": "0.5rem", "$description": "8px list row separation" },
      "list-lg": { "$value": "0.75rem", "$description": "12px list row separation" },
      "control": { "$value": "2.75rem", "$description": "44px minimum touch target" }
    }
  },
  "elevation": {
    "$type": "shadow",
    "floating": { "$value": "0 8px 24px -12px rgb(28 49 63 / 0.28), 0 2px 6px -2px rgb(28 49 63 / 0.10)", "$description": "Scarce: support and current-focus surfaces only." },
    "raised": { "$value": "0 1px 2px rgb(28 49 63 / 0.06)", "$description": "Subtle separation for compact cards." }
  }
}
