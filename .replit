modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

# Forward every artifact service port and both isolated demo preview ports.
# Keep each external port distinct so selecting a demo port cannot fall back
# to the regular NeuroPathways artifact preview.
[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20479
externalPort = 20479

[[ports]]
localPort = 22994
externalPort = 22994

[[ports]]
localPort = 21194
externalPort = 21194

[[ports]]
localPort = 8081
externalPort = 8081

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Clinic onboarding populated demo"

[[workflows.workflow]]
name = "Clinic onboarding fresh demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 scripts/clinic-onboarding/demo-workflow.sh fresh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Clinic onboarding populated demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 scripts/clinic-onboarding/demo-workflow.sh populated"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["poppler"]

[objectStorage]
defaultBucketID = "replit-objstore-8a88a05f-02e1-4201-bce4-e12dafcfd8bd"
