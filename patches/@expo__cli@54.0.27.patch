@@ -0,0 +1,26 @@
+"use strict";
+
+function getFileChangeEvents(changeEvent) {
+    if (Array.isArray(changeEvent.eventsQueue)) {
+        return changeEvent.eventsQueue;
+    }
+
+    const changes = changeEvent.changes;
+    if (!changes) {
+        return [];
+    }
+
+    const events = [];
+    for (const [changeType, eventType] of [
+        ["addedFiles", "add"],
+        ["modifiedFiles", "change"],
+        ["removedFiles", "delete"]
+    ]) {
+        for (const [filePath, metadata] of changes[changeType] ?? []) {
+            events.push({ type: eventType, filePath, metadata });
+        }
+    }
+    return events;
+}
+
+exports.getFileChangeEvents = getFileChangeEvents;
